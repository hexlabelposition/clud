# Copy to .env and adjust. Docker Compose and the Makefile read .env automatically.

# PostgreSQL: used by the postgres container and the Server.
# In docker-compose.yml the Server always connects to the postgres service, so
# POSTGRES_HOST and POSTGRES_PORT only matter when the Server runs on the host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clud
POSTGRES_SCHEMA=public
POSTGRES_USER=clud
# Change for anything but local development.
POSTGRES_PASSWORD=clud

# URL users reach the instance at. With an https:// URL and a public domain,
# Caddy obtains a TLS certificate automatically.
CLUD_PUBLIC_URL=http://localhost

# Registration: invite (default), open (anyone), closed (no new accounts).
# First-run administrator setup is available in every mode.
CLUD_REGISTRATION_MODE=invite

# Requests per client (IPv4 address or IPv6 /64) and endpoint in a fixed window,
# including successful requests.
CLUD_AUTH_RATE_LIMIT_LOGIN_REQUESTS=10
CLUD_AUTH_RATE_LIMIT_REGISTER_REQUESTS=5
CLUD_AUTH_RATE_LIMIT_PASSWORD_REQUESTS=5
CLUD_AUTH_RATE_LIMIT_CSRF_REQUESTS=60
CLUD_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum retained client windows per endpoint. New clients of a full endpoint
# receive 429.
CLUD_AUTH_RATE_LIMIT_MAX_BUCKETS=10000
# Optional comma-separated trusted proxy IPs/CIDRs. Unset: none on the host;
# private IPv4 networks in production Compose, where Server has no published port.
# The trusted proxy must overwrite X-Forwarded-For with one verified client IP.
# For dev behind Caddy, set this to its actual source IP as seen by the Server.
# Set an empty value to trust no proxies in Compose as well.
# CLUD_AUTH_RATE_LIMIT_TRUSTED_PROXIES=
