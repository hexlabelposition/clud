# Copy to .env and adjust. Docker Compose reads .env automatically.

# PostgreSQL: used by the postgres container and the Server.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clud
POSTGRES_SCHEMA=public
POSTGRES_USER=clud
POSTGRES_PASSWORD=clud

# URL users reach the instance at.
CLUD_PUBLIC_URL=http://localhost
